#!/usr/bin/env bash
# Installed by scripts/guard.sh into .public/. Re-checks each commit being pushed: its files, its message and
# its author/committer (GitHub noreply only). Any problem stops the push.
set -uo pipefail
checker="@CHECKER@"
zero=0000000000000000000000000000000000000000
fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list $range); do
    tmp="$(mktemp -d)"
    git archive "$c" | tar -x -C "$tmp"
    git log -1 --format=%B "$c" > "$tmp.msg"
    if ! python3 "$checker" "$tmp" --message "$tmp.msg"; then echo "✗ commit ${c:0:7} holds personal data" >&2; fail=1; fi
    for e in $(git log -1 --format='%ae %ce' "$c"); do
      [[ "$e" == *@users.noreply.github.com ]] || { echo "✗ commit ${c:0:7}: author/committer is not a noreply address" >&2; fail=1; }
    done
    rm -rf "$tmp" "$tmp.msg"
  done
done
[ $fail = 0 ] || echo "push refused: publish with make publish" >&2
exit $fail
